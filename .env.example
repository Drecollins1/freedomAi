# Copy to .env.local for development, and set the same values in your hosting
# provider's environment variables for production.

# --- Admin page (/admin) ---------------------------------------------------
# The password typed into the login form. Without it, nobody can sign in.
ADMIN_PASSWORD= freedom_ai1234
# A long random string used to sign the session cookie.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Settings store --------------------------------------------------------
# Upstash Redis, used to persist what the admin page saves. Create a free
# database at https://console.upstash.com and copy its REST credentials.
# Without these the site serves the defaults in src/lib/content.ts and the
# admin page cannot save.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Where registrations are delivered -------------------------------------
# Telegram bot that posts each signup into a chat you control.
#   1. Message @BotFather, /newbot, copy the token below
#   2. Create a group and add the bot to it
#   3. Send one message there, open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": …}
#      (group ids start with a minus sign)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional second destination — a CRM, an email platform, a Google Sheet relay.
# Receives {firstName, email, whatsapp, source} as JSON.
REGISTRATION_WEBHOOK_URL=
